generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Pillar {
  RENTAL
  SERVICE
}

enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EN_ROUTE
  HANDED_OVER
  ACTIVE
  RETURN_PENDING
  RETURNED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PickupType {
  CLIENT_TO_HOST
  HOST_TO_CLIENT
}

model Listing {
  id          String        @id @default(uuid())
  hostId      String
  title       String
  description String
  pillar      Pillar
  category    String
  subcategory String?
  metadata    Json
  pricePerDay Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  status      ListingStatus @default(DRAFT)
  images      ListingImage[]
  bookings    Booking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Booking {
  id            String        @id @default(uuid())
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id])
  guestId       String
  status        BookingStatus @default(PENDING)
  pickupType    PickupType
  startDate     DateTime
  endDate       DateTime
  priceSnapshot Decimal       @db.Decimal(10, 2)
  currency      String
  totalAmount   Decimal       @db.Decimal(10, 2)
  statusHistory BookingStatusHistory[]
  handovers     Handover[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id])
  status      BookingStatus
  changedById String
  note        String?
  createdAt   DateTime      @default(now())
}

model Handover {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  isPickup       Boolean
  guestConfirmed Boolean   @default(false)
  hostConfirmed  Boolean   @default(false)
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}