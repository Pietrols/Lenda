# Fake environment values for the test runner (CI has no real .env).
# These ONLY exist to satisfy the zod validation in src/config/index.ts —
# they do not connect to any real database or service. All values are
# obvious stubs, so this file is safe to commit.
#
# Loaded by src/tests/load-env.ts AFTER the developer's real .env, and
# dotenv never overrides already-set vars, so local runs still use real
# credentials and CI falls back to these stubs.
NODE_ENV=test
DATABASE_URL=postgresql://test:test@localhost:5432/lenda_test
JWT_ACCESS_SECRET=test-access-secret-do-not-use-in-production
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-in-production
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
R2_ACCOUNT_ID=test-account-id
R2_ACCESS_KEY_ID=test-access-key-id
R2_SECRET_ACCESS_KEY=test-secret-access-key
R2_HOST_IMAGES_PUBLIC_URL=https://test.r2.dev/host-images
