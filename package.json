{
  "name": "lenda",
  "private": true,
  "scripts": {
    "dev:auth": "turbo run dev --filter=auth-service",
    "dev:web": "turbo run dev --filter=web",
    "dev": "turbo run dev --filter=auth-service --filter=booking-service --filter=web",
    "dev:booking": "turbo run dev --filter=booking-service",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "path-to-regexp@<0.1.13": "0.1.13",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "qs@>=6.11.1 <6.15.2": "6.15.2"
    }
  }
}
