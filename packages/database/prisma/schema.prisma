generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  GUEST
  HOST
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  PRO_MONTHLY
  PRO_ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  GRACE_PERIOD
}

enum Pillar {
  RENTAL
  SERVICE
}

enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EN_ROUTE
  HANDED_OVER
  ACTIVE
  RETURN_PENDING
  RETURNED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PickupType {
  CLIENT_TO_HOST
  HOST_TO_CLIENT
}

enum HandoverType {
  PICKUP
  RETURN
}

enum ReviewType {
  GUEST_TO_HOST
  HOST_TO_GUEST
}

enum LikeTargetType {
  LISTING
  REVIEW
  USER
}

enum NotificationType {
  KYC_APPROVED
  KYC_REJECTED
  TIER_UPGRADED
  TIER_DOWNGRADED
  BADGE_AWARDED
  LISTING_SUSPENDED
  REVIEW_REMOVED
  GRACE_PERIOD_STARTED
  SUBSCRIPTION_EXPIRED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  HANDOVER_CONFIRMED
  FLOAT_LOW_BALANCE
  BOOKING_CREATED
  BOOKING_EN_ROUTE
  BOOKING_ACTIVE
  BOOKING_RETURN_PENDING
  BOOKING_COMPLETED
  FIRST_BOOKING
  TIP
}

enum PricingMode {
  FIXED
  HOURLY
  NEGOTIABLE
}

enum CategoryStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  phone              String?            @unique
  passwordHash       String
  roles              Role[]
  emailVerified      Boolean            @default(false)
  phoneVerified      Boolean            @default(false)
  kycStatus          KycStatus          @default(PENDING)
  isActive           Boolean            @default(true)
  fullName           String?
  photoUrl           String?
  bio                String?
  location           String?
  listingTier        Int                @default(0)
  listingTierSetBy   String?
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus?
  subscriptionEndsAt DateTime?
  commissionRate     Float              @default(0.15)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  listings             Listing[]
  bookingsAsGuest      Booking[]              @relation("GuestBookings")
  bookingsAsHost       Booking[]              @relation("HostBookings")
  bookingStatusChanges BookingStatusHistory[]
  reviewsGiven         Review[]               @relation("ReviewsGiven")
  reviewsReceived      Review[]               @relation("ReviewsReceived")
  likes                Like[]
  badges               Badge[]
  notifications        Notification[]

  floatAccount    FloatAccount?

  sentMessages BookingMessage[] @relation("SentMessages")

  kycDocuments     KycDocument[]

  portfolioImages  PortfolioImage[]

  suggestedCategories Category[]

  @@map("users")
}

model Category {
  id               String         @id @default(uuid())
  name             String         @unique
  slug             String         @unique
  status           CategoryStatus @default(APPROVED)
  suggestedPillars String[]
  suggestedById    String?
  suggestedBy      User?          @relation(fields: [suggestedById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("categories")
}

model Listing {
  id             String        @id @default(uuid())
  hostId         String
  host           User          @relation(fields: [hostId], references: [id])
  pillar         Pillar
  category       String
  subcategory    String?
  title          String
  description    String?
  pricePerDay    Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  pricingMode    PricingMode   @default(FIXED)
  location       String
  status         ListingStatus @default(DRAFT)
  metadata       Json          @default("{}")
  discoveryScore Float         @default(0)
  responseRate   Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  images   ListingImage[]
  bookings Booking[]
  likes    Like[]

  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_images")
}

model PortfolioImage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("portfolio_images")
}

model Booking {
  id             String        @id @default(uuid())
  guestId        String
  hostId         String
  listingId      String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  priceSnapshot  Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  totalAmount    Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING)
  pickupType     PickupType
  pickupLocation String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  guest     User                   @relation("GuestBookings", fields: [guestId], references: [id])
  host      User                   @relation("HostBookings", fields: [hostId], references: [id])
  listing   Listing                @relation(fields: [listingId], references: [id])
  history   BookingStatusHistory[]
  handovers Handover[]
  reviews   Review[]
  messages BookingMessage[]

  @@map("bookings")
}

model BookingStatusHistory {
  id          String         @id @default(uuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String
  reason      String?
  createdAt   DateTime       @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id])
  changedBy User    @relation(fields: [changedById], references: [id])

  @@map("booking_status_history")
}

model Handover {
  id               String       @id @default(uuid())
  bookingId        String
  type             HandoverType
  guestConfirmed   Boolean      @default(false)
  hostConfirmed    Boolean      @default(false)
  guestConfirmedAt DateTime?
  hostConfirmedAt  DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("handovers")
}

model Review {
  id          String     @id @default(uuid())
  bookingId   String
  reviewerId  String
  revieweeId  String
  type        ReviewType
  rating      Int
  comment     String?
  isVisible   Boolean    @default(true)
  removedById String?
  removedAt   DateTime?
  removedNote String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  likes    Like[]

  @@map("reviews")
}

model Like {
  id         String         @id @default(uuid())
  userId     String
  targetId   String
  targetType LikeTargetType
  listingId  String?
  reviewId   String?
  createdAt  DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])
  review  Review?  @relation(fields: [reviewId], references: [id])

  @@unique([userId, targetId, targetType])
  @@map("likes")
}

model Badge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  label       String
  awardedById String
  awardedAt   DateTime @default(now())

  @@map("badges")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum MobileMoneyProvider {
  AIRTEL
  MTN
  ZAMTEL
}

enum FloatTransactionType {
  TOP_UP
  COMMISSION_DEDUCTION
  WITHDRAWAL
  WITHDRAWAL_FEE
  ADJUSTMENT
}

enum FloatTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

model FloatAccount {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  balance              Decimal   @default(0) @db.Decimal(10, 2)
  totalEarned          Decimal   @default(0) @db.Decimal(10, 2)
  totalDeducted        Decimal   @default(0) @db.Decimal(10, 2)
  totalWithdrawn       Decimal   @default(0) @db.Decimal(10, 2)
  bookingCount         Int       @default(0)
  mobileMoneyProvider  MobileMoneyProvider
  mobileMoneyNumber    String
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  transactions         FloatTransaction[]
  withdrawals          FloatWithdrawal[]

  @@map("float_accounts")
}

model FloatTransaction {
  id              String                @id @default(uuid())
  floatAccountId  String
  floatAccount    FloatAccount          @relation(fields: [floatAccountId], references: [id])
  type            FloatTransactionType
  amount          Decimal               @db.Decimal(10, 2)
  balanceBefore   Decimal               @db.Decimal(10, 2)
  balanceAfter    Decimal               @db.Decimal(10, 2)
  bookingId       String?
  reference       String?
  status          FloatTransactionStatus @default(COMPLETED)
  note            String?
  createdAt       DateTime              @default(now())

  @@map("float_transactions")
}

model FloatWithdrawal {
  id              String           @id @default(uuid())
  floatAccountId  String
  floatAccount    FloatAccount     @relation(fields: [floatAccountId], references: [id])
  amount          Decimal          @db.Decimal(10, 2)
  fee             Decimal          @db.Decimal(10, 2)
  netAmount       Decimal          @db.Decimal(10, 2)
  provider        MobileMoneyProvider
  mobileNumber    String
  status          WithdrawalStatus @default(PENDING)
  reference       String?
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("float_withdrawals")
}

model BookingMessage {
  id         String   @id @default(uuid())
  bookingId  String
  senderId   String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  sender  User    @relation("SentMessages", fields: [senderId], references: [id])

  @@map("booking_messages")
}

enum KycDocType {
  NRC_FRONT
  NRC_BACK
  PROOF_OF_RESIDENCE
  SELFIE
}

model KycDocument {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  type       KycDocType
  url        String
  uploadedAt DateTime   @default(now())

  @@unique([userId, type])
  @@map("kyc_documents")
}