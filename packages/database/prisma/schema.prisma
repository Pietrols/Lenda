generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  GUEST
  HOST
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Pillar {
  RENTAL
  SERVICE
}

enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EN_ROUTE
  HANDED_OVER
  ACTIVE
  RETURN_PENDING
  RETURNED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PickupType {
  CLIENT_TO_HOST
  HOST_TO_CLIENT
}

enum HandoverType {
  PICKUP
  RETURN
}

enum ReviewType {
  GUEST_TO_HOST
  HOST_TO_GUEST
}

enum LikeTargetType {
  LISTING
  REVIEW
  USER
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  roles         Role[]
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  kycStatus     KycStatus @default(PENDING)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  listings             Listing[]
  bookingsAsGuest      Booking[]              @relation("GuestBookings")
  bookingsAsHost       Booking[]              @relation("HostBookings")
  bookingStatusChanges BookingStatusHistory[]
  reviewsGiven         Review[]               @relation("ReviewsGiven")
  reviewsReceived      Review[]               @relation("ReviewsReceived")
  likes                Like[]

  @@map("users")
}

model Listing {
  id          String        @id @default(uuid())
  hostId      String
  host        User          @relation(fields: [hostId], references: [id])
  pillar      Pillar
  category    String
  subcategory String?
  title       String
  description String?
  pricePerDay Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  location    String
  status      ListingStatus @default(DRAFT)
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  images   ListingImage[]
  bookings Booking[]
  likes    Like[]

  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_images")
}

model Booking {
  id            String        @id @default(uuid())
  guestId       String
  hostId        String
  listingId     String
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  priceSnapshot Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  pickupType    PickupType
  pickupLocation String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  guest     User                   @relation("GuestBookings", fields: [guestId], references: [id])
  host      User                   @relation("HostBookings", fields: [hostId], references: [id])
  listing   Listing                @relation(fields: [listingId], references: [id])
  history   BookingStatusHistory[]
  handovers Handover[]
  reviews   Review[]

  @@map("bookings")
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String
  reason      String?
  createdAt   DateTime      @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id])
  changedBy User    @relation(fields: [changedById], references: [id])

  @@map("booking_status_history")
}

model Handover {
  id               String       @id @default(uuid())
  bookingId        String
  type             HandoverType
  guestConfirmed   Boolean      @default(false)
  hostConfirmed    Boolean      @default(false)
  guestConfirmedAt DateTime?
  hostConfirmedAt  DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("handovers")
}

model Review {
  id          String     @id @default(uuid())
  bookingId   String
  reviewerId  String
  revieweeId  String
  type        ReviewType
  rating      Int
  comment     String?
  isVisible   Boolean    @default(true)
  removedById String?
  removedAt   DateTime?
  removedNote String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  likes    Like[]

  @@map("reviews")
}

model Like {
  id         String        @id @default(uuid())
  userId     String
  targetId   String
  targetType LikeTargetType
  listingId  String?
  reviewId   String?
  createdAt  DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])
  review  Review?  @relation(fields: [reviewId], references: [id])

  @@unique([userId, targetId, targetType])
  @@map("likes")
}