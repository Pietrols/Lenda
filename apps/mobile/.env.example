# Copy this file to .env and fill in your machine's LAN IP.
# Find it with: ipconfig getifaddr en0 (Mac) or ipconfig (Windows)
# Required because Expo Go on a physical phone cannot reach "localhost" --
# that resolves to the phone itself, not your dev machine.

EXPO_PUBLIC_AUTH_URL=http://192.168.1.100:3001
EXPO_PUBLIC_BOOKING_URL=http://192.168.1.100:3002
